# Nova local secret/config template.
# Copy to `.env` and fill in real values. `.env` is gitignored.

# LLM / search gateway (9Router, OpenAI-compatible).
NOVA_LLM_BASE_URL=http://localhost:20128/v1
NOVA_LLM_API_KEY=

# Optional: model overrides used by the brain (task router).
NOVA_LLM_MODEL_FAST=
NOVA_LLM_MODEL_SMART=
