# Nova local secret/config template.
# Copy to `.env` and fill in real values. `.env` is gitignored.

# LLM endpoint (OpenAI-compatible). Base URL defaults to the local gateway.
NOVA_LLM_BASE_URL=http://localhost:20128/v1
NOVA_LLM_API_KEY=
NOVA_LLM_MODEL=

# Web search provider used by the brain's web_search tool.
NOVA_LLM_SEARCH_PROVIDER=tavily

# Optional: override the brain's system prompt (default in config.toml).
NOVA_BRAIN_SYSTEM_PROMPT=

# Optional: override the SQLite database path (default data/nova.db).
NOVA_STORE_DB_PATH=
